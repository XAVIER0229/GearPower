<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GearPower"
        Width="1160" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource GhostForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostPressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="KpiCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="24"/>
      <Setter Property="Padding" Value="18,14"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#D6C8BD" BlurRadius="24" ShadowDepth="11"
                            Direction="45" Opacity="0.62"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NeoButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Margin="4" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="Move" Y="0"/>
              </Grid.RenderTransform>
              <Border x:Name="Light" CornerRadius="16" Background="{TemplateBinding Background}"
                      IsHitTestVisible="False">
                <Border.Effect>
                  <DropShadowEffect Color="#FFFFFF" BlurRadius="10" ShadowDepth="4"
                                    Direction="225" Opacity="0.9"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Dark" CornerRadius="16" Background="{TemplateBinding Background}"
                      IsHitTestVisible="False">
                <Border.Effect>
                  <DropShadowEffect Color="#D6C8BD" BlurRadius="12" ShadowDepth="5"
                                    Direction="45" Opacity="0.95"/>
                </Border.Effect>
              </Border>
              <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <Grid>
                  <Border x:Name="Inset" CornerRadius="16" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#CCB8A493" Offset="0"/>
                        <GradientStop Color="#66B8A493" Offset="0.38"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.66"/>
                        <GradientStop Color="#CCFFFFFF" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.97"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NeoIconButton" TargetType="Button" BasedOn="{StaticResource NeoButton}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="NeumorphicOptionButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SummaryBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Margin="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#D6C8BD" BlurRadius="8" ShadowDepth="3"
                                  Direction="45" Opacity="0.9"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostPressedBrush}"/>
                <Setter TargetName="Bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#D6C8BD" BlurRadius="5" ShadowDepth="0" Opacity="0.35"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IosSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="50" Height="28" Background="Transparent">
              <Border x:Name="Track" Width="50" Height="28" CornerRadius="14"
                      Background="{DynamicResource PanelBrush}" BorderThickness="0">
                <Grid>
                  <Border x:Name="TrackInset" CornerRadius="14" Opacity="0.55" IsHitTestVisible="False">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#55D6C8BD" Offset="0"/>
                        <GradientStop Color="#22D6C8BD" Offset="0.42"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                        <GradientStop Color="#88FFFFFF" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="Knob" Width="22" Height="22" CornerRadius="11"
                      Background="{DynamicResource PanelBrush}" HorizontalAlignment="Left"
                      VerticalAlignment="Center" Margin="3,0,0,0">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="KnobShift" X="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="45"
                                    Opacity="0.55" Color="#D6C8BD"/>
                </Border.Effect>
                <Ellipse x:Name="Led" Width="5" Height="5" Fill="{DynamicResource SwitchOnBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                  <Ellipse.Effect>
                    <DropShadowEffect Color="#2F4BD0" BlurRadius="5" ShadowDepth="0" Opacity="0.55"/>
                  </Ellipse.Effect>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#0E2F4BD0"/>
                
                <Setter TargetName="Led" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobShift"
                                       Storyboard.TargetProperty="X" To="22"
                                       Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.32"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobShift"
                                       Storyboard.TargetProperty="X" To="0"
                                       Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                          <BackEase EasingMode="EaseOut" Amplitude="0.32"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Opacity" Value="0.94"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MenuButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TabInactiveForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="76"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ControlTemplate x:Key="NeumorphicTabTemplate" TargetType="Button">
      <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="Lift" Y="0"/>
        </Grid.RenderTransform>
        <Border x:Name="Highlight" CornerRadius="12" Margin="4,2,4,5"
                Background="{DynamicResource TabBarBrush}">
          <Border.Effect>
            <DropShadowEffect Color="#FFFFFF" BlurRadius="12" ShadowDepth="4"
                              Direction="225" Opacity="0.55"/>
          </Border.Effect>
        </Border>
        <Border x:Name="Keycap" CornerRadius="12" Margin="4,2,4,5"
                Background="{DynamicResource TabBarBrush}"
                BorderThickness="0">
          <Border.Effect>
            <DropShadowEffect x:Name="KeyShadow" Color="#000000" BlurRadius="10"
                              ShadowDepth="2" Direction="45" Opacity="0.30"/>
          </Border.Effect>
          <Grid>
            <Border x:Name="Inset" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Ellipse x:Name="Led" Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                     Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Border>
      </Grid>
    </ControlTemplate>

    <Style x:Key="NeumorphicTabButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TabInactiveForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="82"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template" Value="{StaticResource NeumorphicTabTemplate}"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource TooltipBgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TooltipForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="MaxWidth" Value="620"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource GhostForegroundBrush}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F1707A"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="34"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Custom title bar -->
    <Grid Grid.Row="0" Height="34">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinButton" Style="{StaticResource WindowButton}" Content="&#xE921;"
                ToolTip="最小化"/>
        <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                ToolTip="最大化"/>
        <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                ToolTip="关闭到托盘"/>
      </StackPanel>
    </Grid>

    <!-- Sidebar + Main -->
    <Grid Grid.Row="1" Margin="24,24,24,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource KpiCard}" Background="{DynamicResource PanelBrush}" BorderBrush="#4DFFFFFF"
              BorderThickness="1" CornerRadius="24">
        <Border.Effect>
          <DropShadowEffect Color="#D6C8BD" BlurRadius="24" ShadowDepth="11"
                            Direction="45" Opacity="0.62"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="16,22,14,0">
            <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource PanelBrush}"
                    HorizontalAlignment="Left" Margin="0,0,0,12">
              <Border.Effect>
                <DropShadowEffect Color="#D6C8BD" BlurRadius="10" ShadowDepth="4"
                                  Direction="45" Opacity="0.7"/>
              </Border.Effect>
              <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="GearPower" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="SOFT UI" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="1,2,0,0"/>
            <TextBlock Text="WORKSPACE" FontFamily="Bahnschrift" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="1,32,0,4"/>
            <Button x:Name="BatteryTab" Style="{StaticResource NeumorphicTabButton}"
                    Width="216" Height="44" HorizontalContentAlignment="Left" Padding="16,0"
                    Foreground="{DynamicResource TabActiveForegroundBrush}" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="电量" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="DeviceTab" Style="{StaticResource NeumorphicTabButton}"
                    Width="216" Height="44" HorizontalContentAlignment="Left" Padding="16,0"
                    Foreground="{DynamicResource TabInactiveForegroundBrush}" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="设备清单" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="ProfileTab" Style="{StaticResource NeumorphicTabButton}"
                    Width="216" Height="44" HorizontalContentAlignment="Left" Padding="16,0"
                    Foreground="{DynamicResource TabInactiveForegroundBrush}" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="设备适配" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="SettingsTab" Style="{StaticResource NeumorphicTabButton}"
                    Width="216" Height="44" HorizontalContentAlignment="Left" Padding="16,0"
                    Foreground="{DynamicResource TabInactiveForegroundBrush}" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="设置" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Grid.Row="2" Margin="18,0,18,18" Background="{DynamicResource PanelBrush}"
                  CornerRadius="24" Padding="16">
            <StackPanel>
              <TextBlock Text="本地读取" FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
              <TextBlock Text="不上传设备数据" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text="功率数据仅保存在本机" FontSize="9.5"
                         Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="30,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="GEARPOWER / BATTERY" FontFamily="Bahnschrift" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
          <TextBlock Text="设备电量" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/>
          <TextBlock Text="无线外设状态，一屏掌握。" FontSize="11.5"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="12,4" Margin="0,0,10,0">
            <Border.Effect>
              <DropShadowEffect Color="#D6C8BD" BlurRadius="10" ShadowDepth="4"
                                Direction="45" Opacity="0.65"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="蓝牙" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ToggleButton x:Name="BluetoothEnabledSwitch" Style="{StaticResource IosSwitch}"
                            AutomationProperties.Name="显示蓝牙设备电量" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="RefreshButton" Style="{StaticResource NeoButton}" Height="40"
                  ToolTip="立即重新扫描（F5）">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                         FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource RefreshGlyphBrush}"/>
              <TextBlock Text="重新扫描" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="SummaryDot" Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock x:Name="SummaryText" Text="正在扫描设备…" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryDetail" Text="" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="DemoBadge" Visibility="Collapsed" Background="{DynamicResource DemoBgBrush}"
                    BorderBrush="{DynamicResource DemoBorderBrush}" BorderThickness="1" CornerRadius="7"
                    Padding="7,3" Margin="0,0,10,0">
              <TextBlock Text="演示数据" FontSize="10" Foreground="{DynamicResource DemoTextBrush}"/>
            </Border>
            <TextBlock x:Name="ScanTimeText" Text="" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource KpiCard}" Background="{DynamicResource PanelBrush}" BorderBrush="#4DFFFFFF"
                  BorderThickness="1" CornerRadius="24" Padding="18,14" Margin="0,0,9,0">
            <StackPanel>
              <TextBlock Text="已连接" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock x:Name="KpiConnectedValue" Text="—" FontFamily="Bahnschrift" FontSize="31"
                         FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource KpiCard}" Background="{DynamicResource PanelBrush}" BorderBrush="#4DFFFFFF"
                  BorderThickness="1" CornerRadius="24" Padding="18,14" Margin="3,0,9,0">
            <StackPanel>
              <TextBlock Text="平均电量" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock x:Name="KpiAverageValue" Text="—" FontFamily="Bahnschrift" FontSize="31"
                         FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource KpiCard}" Background="{DynamicResource PanelBrush}" BorderBrush="#4DFFFFFF"
                  BorderThickness="1" CornerRadius="24" Padding="18,14" Margin="3,0,9,0">
            <StackPanel>
              <TextBlock Text="低电量" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock x:Name="KpiLowValue" Text="—" FontFamily="Bahnschrift" FontSize="31"
                         FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Style="{StaticResource KpiCard}" Background="{DynamicResource PanelBrush}" BorderBrush="#4DFFFFFF"
                  BorderThickness="1" CornerRadius="24" Padding="18,14" Margin="3,0,0,0">
            <StackPanel>
              <TextBlock Text="历史设备" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock x:Name="KpiHistoryValue" Text="—" FontFamily="Bahnschrift" FontSize="31"
                         FontWeight="SemiBold" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="1">
        <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,2,0">
          <WrapPanel x:Name="CardPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="132" Height="132" CornerRadius="66" Background="{DynamicResource EmptyOrbBrush}"
                  BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
            <Grid>
              <Ellipse Width="112" Height="112" Stroke="{DynamicResource EmptyRingBrush}" StrokeThickness="1.5" StrokeDashArray="2 4"/>
              <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{DynamicResource EmptyGlyphBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <TextBlock Text="还没有发现电量设备" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          <TextBlock Text="插好 2.4G 接收器、打开设备电源，然后点「重新扫描」。"
                     FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
          <TextBlock Text="如果设备已接好却读不到，请到「设备清单」复制诊断信息。"
                     FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <Button x:Name="EmptyRescan" Style="{StaticResource PrimaryButton}" Content="重新扫描" Margin="0,20,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <Border x:Name="InventoryView" Visibility="Collapsed" Background="{DynamicResource SummaryBrush}"
                BorderBrush="{DynamicResource SummaryBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
          <Border.Effect>
            <DropShadowEffect Color="#D6C8BD" BlurRadius="20" ShadowDepth="5" Direction="45" Opacity="0.45"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="20,16,20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="设备清单" FontSize="14" FontWeight="SemiBold"/>
                  <TextBlock x:Name="InventoryCount" Text="" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                             Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="所有 HID 接口的原始信息。读不到电量时，复制诊断信息发给开发者即可适配。"
                           FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="CopyDiagButton" Grid.Column="1" Style="{StaticResource NeoButton}" Content="复制诊断信息"
                      BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="0.65*"/>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1.9*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="设备" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Grid.Column="1" Text="类型" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Grid.Column="2" Text="VID:PID" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Grid.Column="3" Text="用途页" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Grid.Column="4" Text="IF" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Grid.Column="5" Text="报告" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Grid.Column="6" Text="状态" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="InventoryPanel" Margin="12,0,10,12"/>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource GhostHoverBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="18,11">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="没有你想要的设备？" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="把型号和诊断信息发给我，我会继续适配。" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="DeviceRequestButton" Grid.Column="1" Style="{StaticResource NeoButton}"
                        Content="提交给开发者" BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" Padding="14,7" FontSize="10.5" VerticalAlignment="Center"
                        ToolTip="在浏览器中打开 GitHub 新建 Issue"/>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="ProfileView" Visibility="Collapsed" Background="{DynamicResource SummaryBrush}"
                BorderBrush="{DynamicResource SummaryBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
          <Border.Effect>
            <DropShadowEffect Color="#D6C8BD" BlurRadius="20" ShadowDepth="5" Direction="45" Opacity="0.45"/>
          </Border.Effect>
          <Grid x:Name="ProfileHost"/>
        </Border>

        <Border x:Name="SettingsView" Visibility="Collapsed" Background="{DynamicResource SummaryBrush}"
                BorderBrush="{DynamicResource SummaryBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
          <Border.Effect>
            <DropShadowEffect Color="#D6C8BD" BlurRadius="20" ShadowDepth="5" Direction="45" Opacity="0.45"/>
          </Border.Effect>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">
              <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="外观、刷新、托盘与工具都集中在这里。" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                         Margin="0,4,0,0"/>

              <Border Background="{DynamicResource SummaryBrush}" BorderBrush="{DynamicResource SummaryBorderBrush}"
                      BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="选择浅色、深色，或跟随 Windows 的应用主题。" FontSize="10.5"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ThemeSystemOption" Style="{StaticResource NeumorphicOptionButton}" Content="跟随系统"
                            Tag="System" Padding="14,7" FontSize="11"/>
                    <Button x:Name="ThemeLightOption" Style="{StaticResource NeumorphicOptionButton}" Content="浅色"
                            Tag="Light" Padding="14,7" FontSize="11" Margin="6,0,0,0"/>
                    <Button x:Name="ThemeDarkOption" Style="{StaticResource NeumorphicOptionButton}" Content="深色"
                            Tag="Dark" Padding="14,7" FontSize="11" Margin="6,0,0,0"/>
                  </WrapPanel>
                  <TextBlock Text="强调色" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,12,0,0"/>
                  <WrapPanel Margin="0,7,0,0">
                    <Button x:Name="AccentGreenOption" Style="{StaticResource NeumorphicOptionButton}" Padding="10,6"
                            FontSize="10.5" Tag="Green">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" VerticalAlignment="Center"/>
                        <TextBlock Text="绿色" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="AccentPinkOption" Style="{StaticResource NeumorphicOptionButton}" Padding="10,6"
                            FontSize="10.5" Tag="Pink" Margin="6,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#EC4899" VerticalAlignment="Center"/>
                        <TextBlock Text="粉色" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="AccentYellowOption" Style="{StaticResource NeumorphicOptionButton}" Padding="10,6"
                            FontSize="10.5" Tag="Yellow" Margin="6,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#EAB308" VerticalAlignment="Center"/>
                        <TextBlock Text="黄色" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="AccentBlueOption" Style="{StaticResource NeumorphicOptionButton}" Padding="10,6"
                            FontSize="10.5" Tag="Blue" Margin="6,0,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" VerticalAlignment="Center"/>
                        <TextBlock Text="蓝色" Margin="6,0,0,0"/>
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SummaryBrush}" BorderBrush="{DynamicResource SummaryBorderBrush}"
                      BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="自动刷新" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="设备休眠时也会按这个间隔重新尝试读取。" FontSize="10.5"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="Refresh30Option" Style="{StaticResource NeumorphicOptionButton}" Content="30 秒"
                            Tag="30" Padding="14,7" FontSize="11"/>
                    <Button x:Name="Refresh60Option" Style="{StaticResource NeumorphicOptionButton}" Content="60 秒"
                            Tag="60" Padding="14,7" FontSize="11" Margin="6,0,0,0"/>
                    <Button x:Name="Refresh300Option" Style="{StaticResource NeumorphicOptionButton}" Content="5 分钟"
                            Tag="300" Padding="14,7" FontSize="11" Margin="6,0,0,0"/>
                    <Button x:Name="RefreshOffOption" Style="{StaticResource NeumorphicOptionButton}" Content="关闭"
                            Tag="0" Padding="14,7" FontSize="11" Margin="6,0,0,0"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SummaryBrush}" BorderBrush="{DynamicResource SummaryBorderBrush}"
                      BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="系统托盘" FontSize="13" FontWeight="SemiBold"/>
                  <TextBlock Text="关闭托盘后，关闭主窗口会直接退出。" FontSize="10.5"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="显示托盘图标" FontSize="11.5"/>
                      <TextBlock Text="任务栏通知区域显示 iPhone 风格电池" FontSize="10"
                                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="TrayEnabledSwitch" Grid.Column="1" Style="{StaticResource IosSwitch}"
                                  AutomationProperties.Name="显示托盘图标" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="悬停显示电量卡片" FontSize="11.5"/>
                      <TextBlock Text="鼠标停留在托盘图标上时列出全部设备" FontSize="10"
                                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="HoverEnabledSwitch" Grid.Column="1" Style="{StaticResource IosSwitch}"
                                  AutomationProperties.Name="悬停显示电量卡片" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="关闭窗口时" FontSize="11.5" Margin="0,14,0,0"/>
                  <TextBlock Text="选择点击右上角关闭按钮后的行为；也可以在弹窗里勾选记住选择。" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="CloseAskOption" Style="{StaticResource NeumorphicOptionButton}" Content="每次询问"
                            Tag="0" Padding="12,6" FontSize="10.5"/>
                    <Button x:Name="CloseTrayOption" Style="{StaticResource NeumorphicOptionButton}" Content="关闭到托盘"
                            Tag="1" Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                    <Button x:Name="CloseExitOption" Style="{StaticResource NeumorphicOptionButton}" Content="直接退出"
                            Tag="2" Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SummaryBrush}" BorderBrush="{DynamicResource SummaryBorderBrush}"
                      BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="启动" FontSize="13" FontWeight="SemiBold"/>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="开机自动启动" FontSize="11.5"/>
                      <TextBlock Text="登录 Windows 后正常显示主窗口、托盘和任务栏电量条" FontSize="10"
                                 Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource IosSwitch}"
                                  AutomationProperties.Name="开机自动启动" VerticalAlignment="Center"/>
                  </Grid>
                  <Button x:Name="GuideButton" Style="{StaticResource NeoButton}"
                          Content="重新查看功能引导" Padding="12,6" FontSize="10.5"
                          HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SummaryBrush}" BorderBrush="{DynamicResource SummaryBorderBrush}"
                      BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="任务栏电量条" FontSize="13" FontWeight="SemiBold"/>
                      <Border Background="{DynamicResource DemoBgBrush}" BorderBrush="{DynamicResource DemoBorderBrush}"
                              BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="实验性" FontSize="9" Foreground="{DynamicResource DemoTextBrush}"/>
                      </Border>
                    </StackPanel>
                    <ToggleButton x:Name="TaskbarEnabledSwitch" Style="{StaticResource IosSwitch}"
                                  AutomationProperties.Name="任务栏电量条"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="利用徽标居中时任务栏左侧的空白区域，显示少量设备电量；徽标靠左时自动隐藏，不遮挡应用按钮。"
                             FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                  <Grid Margin="0,12,0,0">
                    <TextBlock Text="高对比度状态栏" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ToggleButton x:Name="TaskbarContrastSwitch" Style="{StaticResource IosSwitch}"
                                  AutomationProperties.Name="高对比度状态栏"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="切换深色高对比度任务栏条"/>
                  </Grid>
                  <TextBlock Text="深色底、白色设备名、亮色电量，适合浅色或深色任务栏。" FontSize="9.5"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                  <TextBlock Text="状态颜色" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,12,0,0"/>
                  <TextBlock Text="只影响任务栏电量条，不改变托盘电池图标。" FontSize="9.5"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                  <WrapPanel Margin="0,7,0,0">
                    <Button x:Name="TaskbarNormalColorButton" Style="{StaticResource NeoButton}" Content="正常"
                            Padding="12,5" FontSize="10" ToolTip="点击修改正常电量颜色"/>
                    <Button x:Name="TaskbarWarnColorButton" Style="{StaticResource NeoButton}" Content="偏低"
                            Padding="12,5" FontSize="10" Margin="6,0,0,0" ToolTip="点击修改偏低电量颜色"/>
                    <Button x:Name="TaskbarDangerColorButton" Style="{StaticResource NeoButton}" Content="过低"
                            Padding="12,5" FontSize="10" Margin="6,0,0,0" ToolTip="点击修改低电量颜色"/>
                    <Button x:Name="TaskbarColorResetButton" Style="{StaticResource NeoButton}" Content="恢复默认"
                            Padding="10,5" FontSize="9.5" Margin="10,0,0,0"/>
                  </WrapPanel>
                  <TextBlock x:Name="TaskbarStatusText" Text="已关闭" FontSize="10"
                             Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                  <TextBlock Text="检测策略：启动时检测一次 + 设置/显示器变化时重查 + 开启时每 3 秒轻量校验；关闭时零检测。"
                             FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource SummaryBrush}" BorderBrush="{DynamicResource SummaryBorderBrush}"
                      BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="工具" FontSize="13" FontWeight="SemiBold"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="SettingsFolderButton" Style="{StaticResource NeoButton}" Content="打开文件夹"
                            Padding="12,6" FontSize="10.5"/>
                    <Button x:Name="SettingsLogButton" Style="{StaticResource NeoButton}" Content="打开日志"
                            Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                    <Button x:Name="SettingsLiveLogButton" Style="{StaticResource NeoButton}" Content="实时日志"
                            Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                    <Button x:Name="SettingsTrayHelpButton" Style="{StaticResource NeoButton}" Content="托盘帮助"
                            Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                    <Button x:Name="SettingsElevateButton" Style="{StaticResource NeoButton}" Content="以管理员身份重启"
                            Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                    <Button x:Name="SettingsExitButton" Style="{StaticResource NeoButton}" Content="退出程序"
                            Padding="12,6" FontSize="10.5" Margin="6,0,0,0"/>
                  </WrapPanel>
                  <TextBlock Text="本地读取 · 不联网" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                             Margin="0,14,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
        </Grid>
      </Grid>
      </Grid>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="24,0,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="FooterDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="FooterStatus" Text="就绪" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
        <TextBlock x:Name="FooterTime" Text="" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="本地读取 · 不联网" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <Border x:Name="Toast" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,58" Background="{DynamicResource ToastBgBrush}" BorderBrush="{DynamicResource ToastBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="16,10" Opacity="0" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" Text="" FontSize="12" Foreground="{DynamicResource ToastTextBrush}"/>
    </Border>
  </Grid>
</Window>
